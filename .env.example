# MongoDB Connection String (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/birthday_surprise?retryWrites=true&w=majority)
# If not set, the app will automatically fall back to an embedded persistent local store so you can test immediately without any external setup!
MONGODB_URI="mongodb://localhost:27017/birthday_surprise"

# JWT Secret for signing Admin session tokens
SESSION_SECRET="super_secret_birthday_jwt_key_please_change_in_production"

# Initial Admin credentials (auto-seeded on first run if no admin exists)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adminpassword123"

# Port (Cloud Run / Render dynamically injects this, default is 3000)
PORT=3000

# GEMINI_API_KEY: Optional
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

